# Serviciu systemd pentru Gicu (VPS / Linux).
#
# Instalare manuală:
#   sudo cp deploy/gicu.service /etc/systemd/system/gicu.service
#   # editează User= și WorkingDirectory= cu calea ta reală
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gicu
#
# Status / loguri:
#   sudo systemctl status gicu
#   journalctl -u gicu -f

[Unit]
Description=GICU - personaj AI pentru Minecraft
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/aicaracter
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
