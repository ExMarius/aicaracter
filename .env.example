# ─────────────────────────────────────────────────────────────
#  GICU — fișier de configurare
#  Copiază acest fișier ca ".env" și completează valorile.
#  (fără .env, Gicu pornește în modul "offline": fără LLM)
# ─────────────────────────────────────────────────────────────

# ── Serverul de Minecraft ────────────────────────────────────
# Server local:        MC_HOST=localhost
# Server pe Pterodactyl: copiază EXACT adresa din panou (Network / Console),
#                        ex: MC_HOST=node-01.hostul-tau.ro   MC_PORT=25678
MC_HOST=localhost
MC_PORT=25565
# Versiunea serverului. Pune "auto" dacă nu ești sigur (o detectează singur).
MC_VERSION=1.21.4
# Numele de utilizator al botului (cont offline sau Microsoft)
MC_USERNAME=Gicu
# offline = server cu online-mode=false (cracked / paneluri gratuite)
# microsoft = server premium online-mode=true; îți cere un cod pe
#             microsoft.com/link la prima rulare și îl ține minte
MC_AUTH=offline
# Cine îi poate da ordine. Poți pune mai mulți, despărțiți prin virgulă.
MC_OWNER=ExMarius
# Dacă e true, oricine de pe server poate vorbi cu Gicu
MC_ALLOW_ALL_PLAYERS=false
# Parola pentru AuthMe (dacă serverul cere /login). Lasă gol dacă nu ai.
MC_PASSWORD=
# Comandă de autentificare proprie (opțional). {parola} se înlocuiește automat.
# Exemple: MC_AUTH_COMMAND=/login {parola}
#          MC_AUTH_COMMAND=/register {parola} {parola}
MC_AUTH_COMMAND=

# ── Creierul (LLM) ───────────────────────────────────────────
# Funcționează cu orice API compatibil OpenAI: OpenAI, Groq, OpenRouter,
# Together, DeepSeek, LM Studio, Ollama etc.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=600
# tools = function calling (recomandat) | json = pentru modele mici
LLM_MODE=tools

# Exemple:
#   Groq (gratuit, rapid):   LLM_BASE_URL=https://api.groq.com/openai/v1
#                            LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter:              LLM_BASE_URL=https://openrouter.ai/api/v1
#                            LLM_MODEL=anthropic/claude-3.5-sonnet
#   Ollama local (gratis):   LLM_BASE_URL=http://localhost:11434/v1
#                            LLM_MODEL=qwen2.5:7b
#                            LLM_API_KEY=ollama

# ── Personalitate ────────────────────────────────────────────
PERSONA_FILE=persona/gicu.json

# ── Voce (TTS gratuit, Microsoft Edge) ───────────────────────
TTS_ENABLED=true
# Voci românești: ro-RO-EmilNeural (băiat), ro-RO-AlinaNeural (fată)
TTS_VOICE=ro-RO-EmilNeural
TTS_RATE=+8%
TTS_PITCH=+2Hz
TTS_VOLUME=+0%
# Salvează mp3-urile în audio-out/ (util pentru montaj / subtitrări)
TTS_SAVE=false
# Textul mai lung de atât se taie la prima propoziție
TTS_MAX_CHARS=400
# Player audio custom (opțional). {file} se înlocuiește cu calea mp3-ului.
# Windows folosește PowerShell automat, macOS afplay. Pe Linux: mpv sau ffmpeg.
# TTS_PLAYER_CMD=mpv --no-video {file}

# ── Comportament ─────────────────────────────────────────────
# Replici spontane la evenimente (creeper, diamant, noapte, moarte...)
REACTIONS_ENABLED=true
# La cât timp să scoată o vorbă dacă nu se întâmplă nimic (secunde, 0 = oprit)
IDLE_CHAT_SECONDS=180
# Câte gânduri/decizii poate lua la rând pentru o singură comandă
BRAIN_MAX_STEPS=8

# ── Logare ───────────────────────────────────────────────────
LOG_LEVEL=info
